@model RoyalVillaWeb.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="login-page"><div class="login-visual"><div><span class="hero-kicker"><span></span> YOUR ROYAL VILLA ACCOUNT</span><h1>Come on<br />in. <em>Stay awhile.</em></h1><p>Sign in to your account and find your next favourite escape.</p></div><small>STAYS, CURATED · SINCE ALWAYS</small></div><div class="login-panel"><a class="back-link dark" asp-controller="Home" asp-action="Index">← Return to the collection</a><div class="login-form-wrap"><span class="eyebrow">WELCOME BACK</span><h2>Good to see<br /><em>you again.</em></h2><p>Sign in with the email and password for your account.</p><form asp-action="Login" method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-4"><label asp-for="Email">Email address</label><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="username"/><span asp-validation-for="Email" class="field-error"></span></div><div class="mb-4"><label asp-for="Password">Password</label><input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password"/><span asp-validation-for="Password" class="field-error"></span></div><button class="btn btn-dark-green w-100" type="submit">Sign in <span>→</span></button></form><small class="login-footnote">New to Royal Villa? <a asp-action="Register">Create an account</a>.</small></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
