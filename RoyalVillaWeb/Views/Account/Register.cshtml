@model RoyalVillaWeb.Models.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="login-page"><div class="login-visual"><div><span class="hero-kicker"><span></span> FIND YOUR ROYAL VILLA</span><h1>A little room<br />for <em>more.</em></h1><p>Create your account to enjoy the Royal Villa collection.</p></div><small>STAYS, CURATED · SINCE ALWAYS</small></div><div class="login-panel"><a class="back-link dark" asp-controller="Home" asp-action="Index">← Return to the collection</a><div class="login-form-wrap register-wrap"><span class="eyebrow">JOIN THE COLLECTION</span><h2>Create your<br /><em>account.</em></h2><p>All fields are required. New accounts have guest access.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3"><div class="col-6"><label asp-for="FirstName">First name</label><input asp-for="FirstName" class="form-control" autocomplete="given-name"/><span asp-validation-for="FirstName" class="field-error"></span></div><div class="col-6"><label asp-for="LastName">Last name</label><input asp-for="LastName" class="form-control" autocomplete="family-name"/><span asp-validation-for="LastName" class="field-error"></span></div><div class="col-12"><label asp-for="Username">Username</label><input asp-for="Username" class="form-control" autocomplete="username"/><span asp-validation-for="Username" class="field-error"></span></div><div class="col-12"><label asp-for="Email">Email address</label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span></div><div class="col-12"><label asp-for="Password">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="field-error"></span></div><div class="col-12"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="field-error"></span></div><div class="col-12"><button class="btn btn-dark-green w-100" type="submit">Create account <span>→</span></button></div></div></form><small class="login-footnote">Already have an account? <a asp-action="Login">Sign in</a>.</small></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
