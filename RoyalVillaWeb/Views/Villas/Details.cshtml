@model RoyalVillaWeb.Models.VillaDetailsViewModel
@{ ViewData["Title"] = Model.Villa.Name ?? "Villa details"; var image = string.IsNullOrWhiteSpace(Model.Villa.ImageUrl) ? "https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&w=1800&q=90" : Model.Villa.ImageUrl; }
<section class="detail-hero"><img src="@image" alt="@Model.Villa.Name" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=85';"/><div class="detail-overlay"></div><div class="container detail-heading"><a class="back-link" asp-action="Index">← Back to the collection</a><span class="eyebrow">A PRIVATE ROYAL VILLA</span><h1>@Model.Villa.Name</h1><p>@Model.Villa.Rate.ToString("N0") <span>/ night</span></p></div></section>
<section class="container detail-layout"><article class="detail-main"><span class="eyebrow">A PLACE TO CALL YOUR OWN</span><h2>Make yourself <em>at home.</em></h2><p class="detail-copy">@(string.IsNullOrWhiteSpace(Model.Villa.Details) ? "A considered retreat, made for slower mornings and memorable stays." : Model.Villa.Details)</p><div class="detail-facts"><div><span class="fact-icon">⌂</span><strong>@Model.Villa.Sqft.ToString("N0")</strong><small>SQUARE FEET</small></div><div><span class="fact-icon">♙</span><strong>@Model.Villa.Occupancy</strong><small>GUESTS</small></div><div><span class="fact-icon">✳</span><strong>Private</strong><small>ENTIRE VILLA</small></div></div>
    @if (Model.Amenities.Count > 0) { <div class="amenities"><span class="eyebrow">THE LITTLE EXTRAS</span><h3>Thoughtful details</h3><div class="amenity-list">@foreach (var amenity in Model.Amenities) { <div class="amenity-item"><span>✳</span><div><strong>@amenity.Name</strong><small>@amenity.Description</small></div></div> }</div></div> }
</article><aside class="booking-card"><span class="eyebrow">YOUR PRIVATE ESCAPE</span><div class="booking-price">@Model.Villa.Rate.ToString("N0")<small> / night</small></div><p>Rates are shown as provided by the villa owner.</p><div class="booking-note">Online booking is not available yet.</div>@if (Model.IsAdmin) { <hr/><div class="d-flex gap-2"><a class="btn btn-outline-green flex-fill" asp-action="Edit" asp-route-id="@Model.Villa.Id">Edit</a><a class="btn btn-outline-danger flex-fill" asp-action="Delete" asp-route-id="@Model.Villa.Id">Delete</a></div> }</aside></section>
