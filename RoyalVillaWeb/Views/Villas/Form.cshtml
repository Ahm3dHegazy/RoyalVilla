@model RoyalVillaWeb.Models.VillaFormViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Edit villa" : "Add a villa"; }
<section class="form-page container"><a class="back-link dark" asp-action="Index">← Back to villas</a><div class="form-heading"><span class="eyebrow">OWNER STUDIO</span><h1>@(editing ? "Refine your" : "Introduce your") <em>villa.</em></h1><p>Share the details that help guests picture their stay.</p></div><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="villa-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field-wide"><label asp-for="Name">Villa name</label><input asp-for="Name" class="form-control" placeholder="e.g. Casa del Mare" autocomplete="off"/><span asp-validation-for="Name" class="field-error"></span></div><div class="field-wide"><label asp-for="Details">A little about the villa</label><textarea asp-for="Details" class="form-control" rows="4" placeholder="Describe the details that make this stay special"></textarea><span asp-validation-for="Details" class="field-error"></span></div><div><label asp-for="Rate">Nightly rate (as configured)</label><input asp-for="Rate" class="form-control" type="number" step="any"/><span asp-validation-for="Rate" class="field-error"></span></div><div><label asp-for="Sqft">Interior space (sqft)</label><input asp-for="Sqft" class="form-control" type="number"/><span asp-validation-for="Sqft" class="field-error"></span></div><div><label asp-for="Occupancy">Maximum guests</label><input asp-for="Occupancy" class="form-control" type="number"/><span asp-validation-for="Occupancy" class="field-error"></span></div><div class="field-wide"><label asp-for="ImageUrl">Villa image URL <span class="optional">(optional)</span></label><input asp-for="ImageUrl" class="form-control" placeholder="https://…"/><span asp-validation-for="ImageUrl" class="field-error"></span></div></div><div class="form-actions"><a class="text-link" asp-action="Index">Cancel</a><button class="btn btn-dark-green" type="submit">@(editing ? "Save changes" : "Create villa") <span>→</span></button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
